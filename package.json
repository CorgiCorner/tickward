{
  "name": "tickward",
  "version": "0.18.1",
  "description": "Open-source countdown timers with projects, sharing, account sync, and a versioned API.",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://tickward.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorgiCorner/tickward.git"
  },
  "bugs": {
    "url": "https://github.com/CorgiCorner/tickward/issues"
  },
  "keywords": [
    "countdown",
    "timer",
    "self-hosted",
    "nextjs",
    "productivity"
  ],
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.3 <11",
      "onFail": "error"
    }
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser@2": "2.4.0",
    "kysely": "0.28.17",
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate-if-available.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "biome format --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:node": "node scripts/check-node-version.mjs",
    "test": "vitest run --project 'unit*'",
    "test:unit": "vitest run --project 'unit*'",
    "test:storybook": "vitest run --project storybook",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:visual": "node scripts/smoke-visual.mjs",
    "smoke:email-otp": "node scripts/smoke-email-otp.mjs",
    "smoke:webhook-receivers": "node scripts/smoke-webhook-receivers.mjs",
    "smoke:agent-ready": "node scripts/smoke-agent-ready.mjs",
    "smoke:docker": "node scripts/smoke-docker.mjs",
    "demo:seed": "node scripts/open-demo-seed.mjs",
    "press:screenshots": "node scripts/press-screenshots.mjs",
    "press:kit": "node scripts/build-press-kit.mjs",
    "security:dependencies": "node scripts/dependency-audit.mjs",
    "release:check:ci": "npm run check:node && npm run security:dependencies && npm run lint && npx tsc --noEmit && npm run test:unit",
    "release:check": "npm run release:check:ci && npm run test:storybook && npm run smoke:app && npm run smoke:visual && npm run smoke:email-otp && npm run build && npm run build-storybook && npm run smoke:docker",
    "test:watch": "vitest --project 'unit*'",
    "test:coverage": "vitest run --project 'unit*' --coverage",
    "db:download-rds-ca": "node scripts/download-rds-ca.mjs",
    "db:generate": "node scripts/prisma-generate-if-available.mjs",
    "db:grant-runtime": "node scripts/grant-runtime-db-privileges.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-bootstrap.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "postinstall": "node scripts/prisma-generate-if-available.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "immer": "^11.1.15",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-swipeable-list": "^1.10.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "napi-postinstall": "^0.3.4",
    "playwright": "^1.62.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.2.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": "biome format --write --files-ignore-unknown=true"
  }
}
